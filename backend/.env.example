# ============================================================================
# Agente OAZ — variáveis de ambiente do backend
# Copie para .env e preencha. NUNCA faça commit do .env com chaves reais.
# ============================================================================

# --- Provedor de LLM principal (escolha um como PRIMARY) --------------------
# "gemini" (recomendado: multimodal, free tier generoso) ou "groq" (mais rápido)
LLM_PRIMARY=gemini
LLM_FALLBACK=groq

# Google Gemini  -> https://aistudio.google.com/apikey  (free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# Groq (Llama + Whisper) -> https://console.groq.com/keys  (free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- Banco vetorial (produção) ----------------------------------------------
# Deixe VECTOR_BACKEND=local para rodar sem banco (usa ingestion/knowledge_base.json).
# Em produção use "supabase" (pgvector).
VECTOR_BACKEND=local
SUPABASE_URL=
SUPABASE_KEY=

# --- Guardrails / comportamento ---------------------------------------------
CHANNELS_URL=https://www.oaz.vc
RETRIEVE_TOP_K=4
MIN_SIMILARITY=0.25
ENABLE_MODERATION=true

# --- App --------------------------------------------------------------------
# origens permitidas (CORS) separadas por vírgula
ALLOWED_ORIGINS=https://www.oaz.vc,http://localhost:8777
PORT=8000
